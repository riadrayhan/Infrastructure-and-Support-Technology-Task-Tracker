# Copy this file to .env and edit it. Every line is optional – the defaults work for local use.

# --- where the server listens ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- database (a single SQLite file, created automatically) ---
DB_FILE=./data/tracker.db

# --- serve the existing frontend from the same address (recommended) ---
SERVE_STATIC=1
# STATIC_DIR=..

# --- only needed when the frontend is hosted somewhere else (GitHub Pages, Vercel) ---
# Comma separated list of exact origins allowed to call this API with cookies.
# CORS_ORIGINS=https://infra-support-task-tracker.vercel.app,https://sajalkumar-byte.github.io

# --- sessions ---
SESSION_TTL_HOURS=12
# Set to 1 when the site is served over HTTPS so cookies are marked Secure.
COOKIE_SECURE=0

# --- throttling ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
RATE_MAX=600
RATE_WINDOW_MINUTES=1

# --- the first super admin, created only when the database has no users at all ---
SEED_SUPERADMIN_EMAIL=admin@tracker.com
SEED_SUPERADMIN_NAME=Super admin
SEED_SUPERADMIN_PASSWORD=Admin@1234

# The extra admin the static build ships with. Set to 0 to skip it.
SEED_TEST_ADMIN=1
SEED_TEST_ADMIN_EMAIL=testadmin@gmail.com
SEED_TEST_ADMIN_NAME=test admin
SEED_TEST_ADMIN_PASSWORD=testpass

LOG_REQUESTS=1
